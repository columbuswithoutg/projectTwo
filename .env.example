# Copy to .env and fill in real values. NEVER commit .env — this repo's
# original first commit leaked one; every secret from it must be rotated.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mcu-tracker

# 32+ chars of real entropy — the server refuses to boot with less.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated allowed CORS origins. Leave unset to disable cross-origin
# entirely (same-origin SPA still works).
CLIENT_URL=http://localhost:3000

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=3000

# Optional TURN relay for cross-NAT voice chat (STUN-only without it).
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
