# Copy to .env and fill in real values. NEVER commit .env — this repo's
# original first commit leaked one; every secret from it must be rotated.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mcu-tracker

# 32+ chars of real entropy — the server refuses to boot with less.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated allowed CORS origins. Leave unset to disable cross-origin
# entirely (same-origin SPA still works).
CLIENT_URL=http://localhost:3000

# Cloudinary (Dashboard → API Keys). Required in production (the server
# refuses to boot without all three); in development a missing one only
# prints a warning, but uploads and memory/profile URLs will fail.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=3000

# How many proxy hops sit in front of the app (Render = 1). Rate limiters,
# audit-log IPs and the socket handshake all read the client address through
# this many X-Forwarded-For entries. Unset or invalid = 1. 0 = no proxy.
# TRUST_PROXY=1

# Outside production the server forces Google DNS (8.8.8.8 / 8.8.4.4) to work
# around networks that break the mongodb+srv SRV lookup. Production keeps the
# host's resolver; set FORCE_PUBLIC_DNS=1 to force Google DNS there too.
# FORCE_PUBLIC_DNS=1

# Optional TURN relay for cross-NAT voice chat (STUN-only without it).
# TURN_URLS=turn:turn.example.com:3478
# Preferred: a shared secret (coturn `use-auth-secret`, or any provider that
# supports the TURN REST credential scheme) — the server mints credentials
# that expire after TURN_TTL_SEC (default 43200 = 12 h) instead of handing
# one permanent pair to every logged-in user.
# TURN_SECRET=
# TURN_TTL_SEC=43200
# Fallback: a static pair from a provider dashboard (used when TURN_SECRET is unset).
# TURN_USERNAME=
# TURN_CREDENTIAL=
